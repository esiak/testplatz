diff --git a/.github/scripts/commit-public.sh b/.github/scripts/commit-public.sh
new file mode 100755
index 0000000..a7e03e3
--- /dev/null
+++ b/.github/scripts/commit-public.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Commits data/public/ once (only if it changed) and pushes it to the branch, then prints the
+# pushed SHA as `sha=<sha>` to $GITHUB_OUTPUT. On a rejected push it fetches, resets to the
+# upstream branch, re-runs the publish command, commits if changed and retries: 3 attempts in all.
+#
+# Env:
+#   PUBLISH_CMD      command that regenerates data/public/ (default: npm run pipeline)
+#   GIT_AUTH_HEADER  optional `AUTHORIZATION: …` header, passed to git fetch/push only
+#   REMOTE           remote name or URL (default: origin)
+#   BRANCH           branch to push to (default: main)
+#   GITHUB_OUTPUT    optional file the `sha=` line is appended to
+set -euo pipefail
+
+PUBLISH_CMD="${PUBLISH_CMD:-npm run pipeline}"
+REMOTE="${REMOTE:-origin}"
+BRANCH="${BRANCH:-main}"
+ATTEMPTS=3
+BOT_NAME='github-actions[bot]'
+BOT_EMAIL='41898282+github-actions[bot]@users.noreply.github.com'
+
+# Keep the credential out of the environment of everything else this script runs (the publish
+# command, git commit/reset); it reaches git only as a command-line config on fetch/push.
+auth_header="${GIT_AUTH_HEADER:-}"
+unset GIT_AUTH_HEADER
+
+# Every git call runs with hooks disabled, so no hook sees the credential or alters the commit.
+local_git() { git -c core.hooksPath=/dev/null "$@"; }
+remote_git() {
+	if [ -n "$auth_header" ]; then
+		git -c core.hooksPath=/dev/null -c "http.extraheader=$auth_header" "$@"
+	else
+		git -c core.hooksPath=/dev/null "$@"
+	fi
+}
+
+for attempt in $(seq 1 "$ATTEMPTS"); do
+	local_git add -- data/public
+	if ! local_git diff --cached --quiet -- data/public; then
+		local_git -c user.name="$BOT_NAME" -c user.email="$BOT_EMAIL" commit --quiet -m 'data: publish snapshot' -- data/public
+		echo "attempt $attempt: committed data/public/"
+	else
+		echo "attempt $attempt: data/public/ unchanged, nothing to commit"
+	fi
+	if remote_git push "$REMOTE" "HEAD:refs/heads/$BRANCH"; then
+		sha="$(local_git rev-parse HEAD)"
+		echo "pushed $sha to $BRANCH"
+		echo "sha=$sha" >> "${GITHUB_OUTPUT:-/dev/null}"
+		exit 0
+	fi
+	if [ "$attempt" -eq "$ATTEMPTS" ]; then break; fi
+	echo "attempt $attempt: push rejected; resetting to $REMOTE/$BRANCH and publishing again" >&2
+	remote_git fetch --quiet "$REMOTE" "$BRANCH"
+	local_git reset --quiet --hard FETCH_HEAD
+	sh -c "$PUBLISH_CMD"
+done
+
+echo "push to $BRANCH rejected $ATTEMPTS times; giving up" >&2
+exit 1
diff --git a/.github/workflows/pipeline.yml b/.github/workflows/pipeline.yml
index d04c86e..53a587f 100644
--- a/.github/workflows/pipeline.yml
+++ b/.github/workflows/pipeline.yml
@@ -9,19 +9,25 @@ concurrency:
   group: pipeline
   cancel-in-progress: false
 
-# Only the deploy job gets the Pages/OIDC token; the build job runs third-party
-# install scripts (npm ci) and must not hold it.
+# Each job gets only what it needs: publish may push data/public/ to main, build holds no write
+# token while it runs third-party install scripts, and only deploy gets the Pages/OIDC token.
 permissions:
   contents: read
 
 jobs:
-  # Story 1.6 adds the "commit data/public/ once, then deploy that SHA" step before the build.
-  build:
+  # Test, run the pipeline, then commit data/public/ once (if it changed) and push it to main.
+  publish:
+    if: github.ref == 'refs/heads/main'
     runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    outputs:
+      sha: ${{ steps.commit.outputs.sha }}
     steps:
       - uses: actions/checkout@v7
         with:
           ref: ${{ github.sha }}
+          persist-credentials: false
       - uses: actions/setup-node@v7
         with:
           node-version-file: .nvmrc
@@ -29,12 +35,38 @@ jobs:
       - run: npm ci
       - run: npm run typecheck
       - run: npm test
+      - run: npm run pipeline
+      - id: commit
+        name: Commit and push data/public/
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          basic="$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')"
+          echo "::add-mask::$basic"
+          unset GH_TOKEN
+          GIT_AUTH_HEADER="AUTHORIZATION: basic $basic" .github/scripts/commit-public.sh
+
+  # Build exactly the SHA the publish job pushed (pushes made with the workflow token do not
+  # trigger another workflow run, so there is no loop).
+  build:
+    needs: publish
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ needs.publish.outputs.sha }}
+          persist-credentials: false
+      - uses: actions/setup-node@v7
+        with:
+          node-version-file: .nvmrc
+          cache: npm
+      - run: npm ci
       - run: npm run build
       - name: Check build output
         run: |
-          for page in dist/index.html dist/about/index.html; do
-            if [ ! -f "$page" ]; then
-              echo "::error::missing $page"
+          for file in dist/index.html dist/about/index.html dist/snapshot.json dist/places.json; do
+            if [ ! -f "$file" ]; then
+              echo "::error::missing $file"
               exit 1
             fi
           done
