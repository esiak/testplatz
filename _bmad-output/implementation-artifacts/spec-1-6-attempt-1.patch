+		expect(snapshot.centres.map((c) => c.centre_id)).toEqual(directory.map((c) => c.centre_id).sort());
+		expect(snapshot.centres.every((c) => c.coverage === 'not_checked' && c.last_result === null)).toBe(true);
+		expect(snapshot.systems).toEqual([]);
