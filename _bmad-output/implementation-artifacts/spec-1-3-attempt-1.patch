+			lon: 10.99,
+			test_page_url: 'https://www.vhs-fuerth.de/einbuergerungstest',
+			reader: 'itemkg',
+			reader_config: { list_url: 'https://www.vhs-fuerth.de/p/x-123-CAT-KAT1' },
+			verified_at: '2026-10-27T08:00:00.000Z',
